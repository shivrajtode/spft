--- calls:
termux-x11 :0
am start --user 0 -n com.termux.x11/com.termux.x11.MainActivity
root-wm size
wake-lock
mount -o bind /dev $T/root/dev
mount -o bind /dev/pts $T/root/dev/pts
mount -t tmpfs -o mode=1777,size=256m tmpfs $T/root/dev/shm
mount -t proc proc $T/root/proc
mount -t sysfs sysfs $T/root/sys
