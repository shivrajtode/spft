=== N. bad options
-- x11 sideways
spft: x11: unknown option 'sideways'  (options: reverse portrait auto zoom=N keys plain reset)
exit=1
-- x11 zoom=abc
spft: x11: zoom=N needs a whole number, for example zoom=150
exit=1
-- x11 zoom=
spft: x11: zoom=N needs a whole number, for example zoom=150
exit=1
-- x11 zoom=500
spft: x11: zoom must be between 30 and 300
exit=1
-- x11 zoom=20
spft: x11: zoom must be between 30 and 300
exit=1
-- x11 zoom=0150
spft: x11: zoom must be between 30 and 300
exit=1
-- x11 zoom=08
spft: x11: zoom must be between 30 and 300
exit=1

