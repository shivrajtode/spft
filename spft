#!/data/data/com.termux/files/usr/bin/bash
# spft - run MediaTek's SP Flash Tool from Termux on a rooted Android phone or tablet.
# (Termux + a root Debian arm64 chroot + box64 + the Termux:X11 display.)
#
#   spft help     lists the commands.
#   README.md     has the short start; docs/GUIDE.md has the step-by-step guide.
#
# Run it from Termux as a normal user. It calls su itself when it needs root.
set -eu

# Root phase: never let Termux's libraries reach Android's own tools (readlink, mount, ...).
# They would load Termux's OpenSSL and die with "CANNOT LINK EXECUTABLE".
if [ "$EUID" -eq 0 ]; then unset LD_LIBRARY_PATH LD_PRELOAD; fi

PREFIX=${PREFIX:-/data/data/com.termux/files/usr}
R=${SPFT_ROOT:-/data/local/spft-debian}
SUITE=${SPFT_SUITE:-trixie}
DL=${SPFT_DL:-${HOME:-/data/local/tmp}/spft-dl}
URL=${SPFT_URL:-https://raw.githubusercontent.com/debuerreotype/docker-debian-artifacts/dist-arm64v8/$SUITE/slim/oci/blobs/rootfs.tar.gz}

# Where this script lives (the `spft` command runs it by its full path; a link to it works too).
resolve_self() {
  local p=$0 t n=0
  case $p in /*) ;; *) p=$PWD/${p#./} ;; esac
  while [ -L "$p" ] && [ "$n" -lt 20 ]; do
    t=$(readlink "$p") || break
    case $t in /*) p=$t ;; *) p=${p%/*}/$t ;; esac
    n=$((n + 1))
  done
  printf '%s\n' "$p"
}
SELF=$(resolve_self)
SPFT_HOME=${SELF%/*}
LIB=$SPFT_HOME/lib

die() { echo "spft: $*" >&2; exit 1; }
say() { printf '\n>> %s\n' "$*"; }
row() { printf '%-10s: %s\n' "$1" "$2"; }
is_root() { [ "$EUID" -eq 0 ]; }

usage() {
  cat <<'EOF'
spft - SP Flash Tool on a rooted phone or tablet (Termux + Debian chroot + box64 + Termux:X11)

  spft                      start SP Flash Tool (the same as: spft x11)
  spft x11 [options]        start it on Termux:X11. The screen is turned to landscape and fullscreen, and zoomed as
                            far as the whole tool window still fits on it (the tool is about 720 pixels tall)
        reverse               landscape the other way up (when the picture is upside down)
        portrait | auto       do not force landscape (zoom is then 100)
        zoom=N                size in percent. The default, zoom=auto, picks the biggest that fits: a 1280x800
                              tablet gets 105, a phone that is 1080 pixels wide gets 145. More cuts off the bottom.
        keys                  keep Termux:X11's extra-keys bar (hidden by default, to make room)
        plain                 leave the Termux:X11 settings alone
        reset                 put the Termux:X11 settings back as they were before spft changed them
  spft vnc                  start it on a VNC desktop instead (viewer app -> localhost:5901, password spft1234)
  spft stop                 force-stop everything of spft: SP Flash Tool and every other program in Debian, the
                            Termux:X11 server and app. Then unmount Debian and clear the caches (Debian's /tmp and
                            ~/.cache, the Termux:X11 app's cache, the phone's memory cache). Never while it is flashing.
  spft tool [FILE|URL|NAME] install or change SP Flash Tool. Without an argument it uses the Linux zip from your
                            Download folder if there is one, and downloads it otherwise.
                            `spft tool list` shows the versions it knows.
  spft check                test the phone and the setup, with a hint for every problem
  spft update               get the newest spft (git pull) and apply it
  spft install              set up Debian + box64 + SP Flash Tool (install.sh runs this for you)
  spft enter [command]      root shell inside Debian (or run one command there)
  spft umount               stop and unmount everything. It says WARNING and exits with 1 if something stays mounted.
  spft uninstall [--yes]    delete the Debian system and the downloads (asks first, and refuses while anything
                            is still mounted - the Debian folder has your phone's /dev and storage mounted inside)

Inside Debian the phone's internal storage is /sdcard, and the tool's file windows start there (the side bar
shows "sdcard" instead of "root"). To open your Download folder, type /sdcard/Download in the "File name" box
and press Enter. SPFT_STORAGE=off spft  leaves the file windows in Debian's own home folder instead.

Made by Shivraj - Telegram @Shivraj_editx - GitHub shivrajtode
EOF
}

# Prints 64, 32 or unknown, from the running kernel's config (CONFIG_ARM64). Android userspace bitness is irrelevant.
kernel_arch() {
  local cfg
  cfg=$(if is_root; then zcat /proc/config.gz; else su -c 'zcat /proc/config.gz'; fi 2>/dev/null || true)
  if [ -z "$cfg" ]; then echo unknown
  elif printf '%s\n' "$cfg" | grep -q '^CONFIG_ARM64=y'; then echo 64
  else echo 32
  fi
}

# Prints y, m or n for CONFIG_USB_ACM (the cdc_acm USB serial driver) in the running kernel's config, or nothing
# when the config can't be read. m = built as a module that may just not be loaded.
acm_config() {
  local cfg
  cfg=$(zcat /proc/config.gz 2>/dev/null || true)
  [ -n "$cfg" ] || return 0
  case "$(printf '%s\n' "$cfg" | grep '^CONFIG_USB_ACM=' || true)" in
    CONFIG_USB_ACM=y) echo y ;;
    CONFIG_USB_ACM=m) echo m ;;
    *) echo n ;;
  esac
}

# free_mb PATH   prints the free space in MB on that path's partition (nothing when it can't be told)
free_mb() {
  local b s
  read -r b s < <(stat -f -c '%a %S' "$1" 2>/dev/null) || return 0
  case ${b}${s} in '' | *[!0-9]*) return 0 ;; esac
  echo $((b * s / 1048576))
}

find_chroot() {
  CHROOT=
  for c in /system/bin/chroot /system/xbin/chroot "$PREFIX/bin/chroot"; do
    if [ -x "$c" ]; then CHROOT=$c; return 0; fi
  done
  return 1
}

chroot_run() { # chroot_run COMMAND...   run a command inside $R (Termux's own chroot needs Termux's libraries)
  if [ "${CHROOT#"$PREFIX"/}" != "$CHROOT" ]; then
    LD_LIBRARY_PATH="$PREFIX/lib" "$CHROOT" "$R" "$@"
  else
    "$CHROOT" "$R" "$@"
  fi
}

need_lib() { [ -d "$LIB" ] || die "the lib folder is missing next to this script - use the whole repository (git clone), not just the spft file"; }
need_su() { command -v su >/dev/null 2>&1 || die "no su found - this needs a rooted phone (Magisk, KernelSU, ...)"; }
root_ok() { [ "$(su -c 'id -u' 2>/dev/null || true)" = 0 ]; }

# The root steps run a copy of this script (and lib/) kept under Termux's own folder: the repository may sit
# on shared storage, which root can't always read.
prep_app() {
  need_lib
  if [ "$SPFT_HOME" != "$DL/app" ]; then
    mkdir -p "$DL/app"
    rm -rf "$DL/app/lib"
    cp -f "$SELF" "$DL/app/spft"
    cp -rf "$LIB" "$DL/app/lib"
  fi
}
root_env() { printf 'LD_LIBRARY_PATH=%s SPFT_ROOT=%s SPFT_SUITE=%s SPFT_DL=%s' "$PREFIX/lib" "$R" "$SUITE" "$DL"; }
# sq WORD   the word in single quotes, so that every POSIX shell reads it back unchanged (also with spaces, quotes, newlines or
# letters outside ASCII). Not printf %q: that writes some of those as $'...', which not every shell understands.
sq() { local s=$1; printf "'%s'" "${s//\'/\'\\\'\'}"; }
root_args() { local a; for a in "$@"; do printf '%s ' "$(sq "$a")"; done; }
# as_root ARGS...   run this script as root with ARGS, and do not come back (the root step replaces this one)
as_root() { prep_app; exec su -c "$(root_env) $PREFIX/bin/bash $DL/app/spft $(root_args "$@")"; }
# root_call ARGS...   the same, but come back with its exit status
root_call() { prep_app; su -c "$(root_env) $PREFIX/bin/bash $DL/app/spft $(root_args "$@")"; }

# Settings for the programs inside Debian (the table of settings in docs/HOW-IT-WORKS.md). Typed in front of the command in
# Termux, for example  SPFT_STORAGE=off spft,  they would never get there: su does not have to pass the environment on, and
# `enter` starts the shell in Debian with `env -i`, which throws all of it away. So the ones that are set travel inside the
# command line itself, as VAR='value' words (the line is read once more by the shell in Debian, hence the quotes).
# Before v4 this was missing: SPFT_FAKE_KERNEL=off spft, which spft itself recommends, had no effect.
DEBIAN_SETTINGS="SPFT_FAKE_KERNEL SPFT_STORAGE SPFT_GEOMETRY BOX64_LOG"
DSET=()   # filled by debian_settings
debian_settings() {
  local v val
  DSET=()
  for v in $DEBIAN_SETTINGS; do
    val=${!v:-}
    if [ -z "$val" ]; then continue; fi
    DSET+=("$v=$(sq "$val")")
  done
}

wake_lock() { if command -v termux-wake-lock >/dev/null 2>&1; then termux-wake-lock >/dev/null 2>&1 || true; fi; }
wake_unlock() { if command -v termux-wake-unlock >/dev/null 2>&1; then termux-wake-unlock >/dev/null 2>&1 || true; fi; }

# Android system properties and apps, as the normal Termux user
prop() { local g; g=$(command -v getprop 2>/dev/null || echo /system/bin/getprop); "$g" "$1" 2>/dev/null || true; }

# root_app_installed PACKAGE   0 installed, 1 not installed, 2 can't tell. Run as root: root sees every app, a normal Termux
# user does not. Since Android 11 an app is only shown the apps it has declared interest in, so `pm list packages` run
# from Termux leaves out, among others, Termux:X11. (spft once reported an installed Termux:X11 as missing for that reason.)
root_app_installed() {
  local pk=$1 name
  if [ -r /data/system/packages.list ]; then
    while read -r name _; do
      if [ "$name" = "$pk" ]; then return 0; fi
    done < /data/system/packages.list
    return 1
  fi
  if [ -d "/data/data/$pk" ] || [ -d "/data/user/0/$pk" ]; then return 0; fi
  if [ -d /data/data ] || [ -d /data/user/0 ]; then return 1; fi
  return 2
}

# app_installed PACKAGE   0 installed, 1 not installed, 2 can't tell. Root is asked first (it sees every app); `pm` is
# asked too, as a normal user, because any source that says "installed" is right (a false "NOT installed" is the worse
# mistake). Without root the answer can only be "installed" (when `pm` lists the app) or "can't tell": a normal user is
# not shown all apps.
app_installed() {
  local pm all ans=
  if command -v su >/dev/null 2>&1; then
    ans=$(root_call root-app-installed "$1" 2>/dev/null | tail -n 1) || ans=
    if [ "$ans" = yes ]; then return 0; fi
  fi
  pm=$(command -v pm 2>/dev/null || echo /system/bin/pm)
  all=$(timeout 25 "$pm" list packages 2>/dev/null || true)
  case $all in *"package:$1"$'\n'* | *"package:$1") return 0 ;; esac
  if [ "$ans" = no ]; then return 1; fi
  return 2
}

is_mounted() { grep -qF " $1 " /proc/mounts; }

# What `enter` mounts into Debian, deepest first for the unmounting (dev/pts and dev/shm sit inside dev)
MOUNT_DIRS="tmp/.X11-unix mnt/sdcard dev/shm dev/pts dev proc sys"

bind() { # bind SRC DST  (skipped when SRC does not exist)
  [ -d "$1" ] || return 0
  mkdir -p "$2"
  is_mounted "$2" || /system/bin/mount -o bind "$1" "$2"
}

mounts() {
  bind /dev "$R/dev"
  bind /dev/pts "$R/dev/pts"
  mkdir -p "$R/dev/shm"
  is_mounted "$R/dev/shm" || /system/bin/mount -t tmpfs -o mode=1777,size=256m tmpfs "$R/dev/shm" || true
  is_mounted "$R/proc" || /system/bin/mount -t proc proc "$R/proc"
  is_mounted "$R/sys" || /system/bin/mount -t sysfs sysfs "$R/sys"
  src=/data/media/0
  [ -d "$src" ] || src=/sdcard
  bind "$src" "$R/mnt/sdcard"
  # Termux:X11's socket folder, so programs in Debian can reach its display (skipped until the X server has started)
  bind "$PREFIX/tmp/.X11-unix" "$R/tmp/.X11-unix"
}

# (Re)write the two helper commands inside Debian. Done on every `enter`, so they are always current.
write_helpers() {
  need_lib
  mkdir -p "$R/usr/local/bin" "$R/root"
  # shortcuts for the tool's file dialogs: /sdcard works like on Android (spft-run starts the tool with that as its home
  # folder); with SPFT_STORAGE=off the home folder is /root, and there sdcard and Download are links to the same places
  ln -sfn /mnt/sdcard "$R/sdcard"
  ln -sfn /mnt/sdcard "$R/root/sdcard"
  ln -sfn /mnt/sdcard/Download "$R/root/Download"
  cp -f "$LIB/gui.sh" "$R/usr/local/bin/spft-gui"
  cp -f "$LIB/run.sh" "$R/usr/local/bin/spft-run"
  chmod 755 "$R/usr/local/bin/spft-gui" "$R/usr/local/bin/spft-run"
  # the kernel-version fix (lib/kernelfix.sh explains it); spft-run reads these
  mkdir -p "$R/usr/local/lib/spft"
  cp -f "$LIB/kernelfix.sh" "$LIB/kernelfix.so.b64" "$R/usr/local/lib/spft/"
}

root_enter() { # root_enter [command...]   mount, then open a shell (or run the command) inside the chroot
  unset LD_LIBRARY_PATH LD_PRELOAD
  [ -x "$R/bin/bash" ] || die "no Debian in $R - run: spft install"
  write_helpers
  find_chroot || die "no chroot command found (tried /system/bin, /system/xbin and Termux)"
  mounts
  if [ $# -gt 0 ]; then set -- -lc "$*"; else set -- -l; fi
  chroot_run /usr/bin/env -i HOME=/root TERM="${TERM:-xterm-256color}" LANG=C.UTF-8 \
    PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin /bin/bash "$@"
}

chroot_pids() { # the PID of every process whose root folder is the Debian folder
  local p
  for p in /proc/[0-9]*; do
    if [ "$(/system/bin/readlink "$p/root" 2>/dev/null)" = "$R" ]; then echo "${p#/proc/}"; fi
  done
}

KILLED=0   # how many processes kill_chroot found

kill_chroot() { # stop everything that runs inside Debian (the tool, openbox, the VNC server ...)
  local pids n
  pids=$(chroot_pids)
  n=$(printf '%s\n' "$pids" | grep -c .) || true
  KILLED=$n
  if [ -n "$pids" ]; then
    # shellcheck disable=SC2086
    kill $pids 2>/dev/null || true
    sleep 2
    pids=$(chroot_pids)
    # shellcheck disable=SC2086
    if [ -n "$pids" ]; then kill -9 $pids 2>/dev/null || true; fi
  fi
  echo "stopped $n process(es) that were running inside Debian"
}

root_umount() {
  unset LD_LIBRARY_PATH LD_PRELOAD
  kill_chroot
  # shellcheck disable=SC2086
  for d in $MOUNT_DIRS; do
    if is_mounted "$R/$d"; then
      /system/bin/umount "$R/$d" || echo "spft: could not unmount $R/$d (busy?)" >&2
    fi
  done
  if grep -qF " $R" /proc/mounts; then
    echo "WARNING: still mounted under $R - do NOT delete that folder until this list is empty:"
    grep -F " $R" /proc/mounts
    return 1
  fi
  echo "all unmounted - $R is safe to delete"
}

# Deletes the Debian folder, but only when nothing is mounted inside it any more. While the mounts are there, the
# folder holds the phone's /dev and its internal storage, and a recursive delete would wipe both.
root_uninstall() {
  unset LD_LIBRARY_PATH LD_PRELOAD
  case $R in
    /*/*/*) ;;
    *) die "refusing to delete '$R': the Debian folder must be at least three levels deep, like /data/local/spft-debian" ;;
  esac
  case $R in
    /proc/* | /sys/* | /dev/* | /system/* | /storage/* | /sdcard/* | /mnt/*) die "refusing to delete '$R'" ;;
  esac
  if [ ! -e "$R" ]; then echo "nothing to delete: $R does not exist"; return 0; fi
  if ! root_umount; then
    echo
    die "NOT deleting $R: something is still mounted inside it (listed above). Restart the phone, then run: spft uninstall"
  fi
  # one more look right before the delete
  if grep -qF " $R" /proc/mounts; then die "NOT deleting $R: something is mounted inside it again"; fi
  echo ">> deleting $R"
  /system/bin/rm -rf "$R"
  if [ -e "$R" ]; then die "could not delete everything in $R"; fi
  echo ">> deleted $R"
}

# --- SP Flash Tool inside Debian: where it is, unpacking a zip --------------------------------------------

root_tool_where() { # prints where an installed SP Flash Tool is; exit status 1 when there is none
  local p
  [ -d "$R/opt" ] || return 1
  p=$(find "$R/opt" -maxdepth 3 -type f \( -name flash_tool -o -name SPFlashToolV6 \) 2>/dev/null | head -n 1)
  [ -n "$p" ] || return 1
  printf '%s\n' "$p"
}

root_find_zip() { # root_find_zip NAME   a Linux SP Flash Tool zip in the phone's Download folder (root can always read it)
  local d f
  for d in /data/media/0/Download /data/media/0; do
    for f in "$d/SP_Flash_Tool_${1}_Linux.zip" "$d"/SP_Flash_Tool*[Ll]inux*.zip; do
      if [ -f "$f" ]; then printf '%s\n' "$f"; return 0; fi
    done
  done
  return 1
}

root_tool() { # root_tool ZIP   unpack SP Flash Tool into Debian's /opt and make it the one that starts
  is_root || die "internal: needs root"
  local zip=$1 p tmp src top dest exe name n hex rel
  [ -x "$R/bin/bash" ] || die "no Debian in $R - run: spft install"
  if [ ! -f "$zip" ]; then # root reaches shared storage through /data/media/0
    for p in /sdcard /storage/emulated/0 /storage/self/primary; do
      case $zip in
        "$p"/*) if [ -f "/data/media/0${zip#"$p"}" ]; then zip=/data/media/0${zip#"$p"}; break; fi ;;
      esac
    done
  fi
  [ -f "$zip" ] || die "cannot read $zip"
  find_chroot || die "no chroot command found (tried /system/bin, /system/xbin and Termux)"
  mkdir -p "$R/opt"
  tmp=$R/opt/.spft-unpack
  rm -rf "$tmp"
  mkdir -p "$tmp"
  echo ">> unpacking $zip"
  if ! env LD_LIBRARY_PATH="$PREFIX/lib" PATH="$PREFIX/bin:$PATH" "$PREFIX/bin/unzip" -q -o "$zip" -d "$tmp"; then
    rm -rf "$tmp"
    die "could not unpack $zip (damaged download? delete it and try again)"
  fi
  # a zip made like SP Flash Tool's has one folder inside; otherwise the zip's own name is used
  n=$(find "$tmp" -mindepth 1 -maxdepth 1 | wc -l)
  src=$tmp
  top=
  if [ "$n" -eq 1 ]; then
    p=$(find "$tmp" -mindepth 1 -maxdepth 1)
    if [ -d "$p" ]; then src=$p; top=${p##*/}; fi
  fi
  if [ -z "$top" ]; then top=${zip##*/}; top=${top%.zip}; fi
  top=$(printf '%s' "$top" | tr -c 'A-Za-z0-9._-' '_')
  case $top in '' | .*) top=spft-tool$top ;; esac
  dest=$R/opt/$top
  rm -rf "$dest"
  mv "$src" "$dest"
  rm -rf "$tmp"
  exe=
  for name in flash_tool SPFlashToolV6; do
    p=$(find "$dest" -maxdepth 3 -type f -name "$name" 2>/dev/null | head -n 1)
    if [ -n "$p" ]; then exe=$p; break; fi
  done
  if [ -z "$exe" ]; then
    rm -rf "$dest"
    die "there is no flash_tool in that zip. Is it the LINUX build of SP Flash Tool (not the Win zip)?"
  fi
  chmod 755 "$exe"
  chmod -R a+rX "$dest" 2>/dev/null || true
  # box64 runs 64-bit x86 programs only: check the file's header from inside Debian (ELF, machine 0x3e = x86-64)
  rel=/opt/${exe#"$R"/opt/}
  hex=$(chroot_run /usr/bin/od -An -tx1 -N20 "$rel" 2>/dev/null | tr -d ' \n') || hex=
  case $hex in
    7f454c46*) ;;
    *) rm -rf "$dest"; die "${exe##*/} in that zip is not a Linux program - wrong zip?" ;;
  esac
  if [ "$(printf '%s' "$hex" | cut -c37-40)" != 3e00 ]; then   # bytes 18-19 of the header: the machine type
    rm -rf "$dest"
    die "${exe##*/} in that zip is not a 64-bit x86 program, and box64 can only run those. Use the 64-bit Linux build."
  fi
  ln -sfn "$top" "$R/opt/spft-current"
  echo ">> installed: $dest"
  echo ">> it is now the one that starts (/opt/spft-current -> $top)"
}

# --- SP Flash Tool: finding or downloading the zip (as the normal Termux user) ---------------------------

UA='Mozilla/5.0 (Linux; Android 10) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0 Mobile Safari/537.36'
TOOL_ZIP=

tool_entries() { awk -v n="$1" '!/^[[:space:]]*(#|$)/ && $1 == n { print $2, $3 }' "$LIB/tools.conf"; }

default_tool() {
  if [ -n "${SPFT_TOOL:-}" ]; then printf '%s\n' "$SPFT_TOOL"; return 0; fi
  awk '!/^[[:space:]]*(#|$)/ { print $1; exit }' "$LIB/tools.conf"
}

tool_list() {
  echo "SP Flash Tool versions spft can download (lib/tools.conf):"
  awk '!/^[[:space:]]*(#|$)/ && !seen[$1]++ { printf "  %-9s %s\n", $1, ($2 == "-" ? "(no checksum known)" : "(checksum known)") }' "$LIB/tools.conf"
  echo "default: $(default_tool)"
  echo "  spft tool NAME        install another one         spft tool FILE.zip    install a zip you already have"
}

note_hash() { # note_hash FILE   print its checksum, and whether lib/tools.conf knows it
  local sha name
  sha=$(sha256sum "$1" 2>/dev/null | cut -d' ' -f1) || return 0
  [ -n "$sha" ] || return 0
  name=$(awk -v s="$sha" '$2 == s { print $1; exit }' "$LIB/tools.conf")
  if [ -n "$name" ]; then
    echo "   sha256 $sha  = SP Flash Tool $name, as recorded in tools.conf"
  else
    echo "   sha256 $sha  (not in tools.conf - fine if you trust where you got it)"
  fi
}

check_zip() { # check_zip FILE SHA|-   a valid zip; when SHA is given, the checksum must match
  local got
  got=$(sha256sum "$1" | cut -d' ' -f1)
  echo "   sha256 $got"
  if [ "$2" != - ]; then
    if [ "$got" != "$2" ]; then
      echo "   !! checksum mismatch - this is not the file that was expected (it should be $2)"
      echo "      The mirror may have re-packed it, or the download was damaged or changed on the way."
      return 1
    fi
    echo "   checksum matches lib/tools.conf"
  else
    echo "   (no checksum is known for this file, so it can't be compared)"
  fi
  if ! unzip -tq "$1" >/dev/null 2>&1; then
    echo "   !! that is not a complete zip file"
    return 1
  fi
}

download_zip() { # download_zip URL SHA OUT   0 when OUT now holds a good zip
  rm -f "$3.part"
  # the same flags as the Arch Linux packages use for this site (-b "" keeps cookies across redirects), plus a browser name
  if curl -gfL -b "" --retry 3 --retry-delay 3 --connect-timeout 20 -A "$UA" -e "$1" -# -o "$3.part" "$1" </dev/null &&
    check_zip "$3.part" "$2"; then
    mv -f "$3.part" "$3"
    return 0
  fi
  rm -f "$3.part"
  return 1
}

fetch_tool() { # fetch_tool NAME   download it into $DL (sets TOOL_ZIP); 1 when none of its addresses worked
  local name=$1 sha url n=0 out=$DL/SP_Flash_Tool_${1}_Linux.zip
  mkdir -p "$DL"
  while read -r sha url; do
    n=$((n + 1))
    if [ -s "$out" ]; then
      echo ">> found an earlier download: $out"
      if check_zip "$out" "$sha"; then TOOL_ZIP=$out; return 0; fi
      rm -f "$out"
    fi
    echo ">> downloading SP Flash Tool $name"
    echo "   $url"
    if download_zip "$url" "$sha" "$out"; then TOOL_ZIP=$out; return 0; fi
    echo "   that address did not work"
  done < <(tool_entries "$name")
  [ "$n" -gt 0 ] || die "tool: '$name' is not a known version (spft tool list)"
  return 1
}

local_zip() { # local_zip NAME   a Linux SP Flash Tool zip in the phone's Download folder
  local d f
  for d in "$HOME/storage/downloads" /sdcard/Download /storage/emulated/0/Download; do
    [ -d "$d" ] || continue
    for f in "$d/SP_Flash_Tool_${1}_Linux.zip" "$d"/SP_Flash_Tool*[Ll]inux*.zip; do
      if [ -f "$f" ]; then printf '%s\n' "$f"; return 0; fi
    done
  done
  root_call root-find-zip "$1" 2>/dev/null # Termux may not be allowed to read shared storage, root can
}

tool_help() { # tool_help NAME   what to do when the automatic download did not work
  cat >&2 <<EOF

>> SP Flash Tool could not be downloaded automatically (no connection, or the mirror is down or has changed).
   Do it by hand instead - it takes a minute:
   1. In your phone's browser download  SP_Flash_Tool_$1_Linux.zip  - the LINUX build, not the Win one.
      Where to get it: https://spflashtools.com/category/linux (more in the Guide on GitHub, docs/GUIDE.md, "If the download fails").
   2. Leave it in your Download folder.
   3. In Termux run:  spft tool
EOF
}

cmd_tool() { # cmd_tool [list|--if-missing|FILE.zip|URL|NAME]
  ! is_root || die "run tool from Termux as a normal user (it calls su itself)"
  need_lib
  local arg=${1:-} name='' zip='' out quiet=0
  case $arg in
    list) tool_list; return 0 ;;
    --if-missing)   # what `spft install` uses: it prints its own last line
      need_su
      if root_call root-tool-where >/dev/null 2>&1; then echo ">> SP Flash Tool is already installed"; return 0; fi
      quiet=1; arg= ;;
  esac
  need_su
  command -v curl >/dev/null 2>&1 || die "curl is missing - run: pkg install curl"
  command -v unzip >/dev/null 2>&1 || die "unzip is missing - run: pkg install unzip"
  case $arg in
    '') name=$(default_tool) ;;
    http://* | https://*)
      mkdir -p "$DL"
      out=$DL/SP_Flash_Tool_custom_Linux.zip
      echo ">> downloading $arg"
      download_zip "$arg" "${SPFT_TOOL_SHA256:--}" "$out" || die "that download did not work"
      zip=$out ;;
    *.zip | */*)
      zip=$arg
      if [ -f "$zip" ]; then
        zip=$(cd "$(dirname "$zip")" && pwd)/$(basename "$zip")
        echo ">> using $zip"
        note_hash "$zip"
      fi ;;
    *) name=$arg ;;
  esac
  if [ -z "$zip" ]; then
    zip=$(local_zip "$name") || zip=
    if [ -n "$zip" ]; then
      echo ">> using the zip that is already on your phone: $zip"
      note_hash "$zip"
    elif fetch_tool "$name"; then
      zip=$TOOL_ZIP
    else
      tool_help "$name"
      return 1
    fi
  fi
  # "|| return 1" is needed: when the caller runs this function in an `||` list (spft install does), the shell
  # ignores `set -e` in here, and a failed unpack would still print "installed" below.
  root_call root-tool "$zip" || return 1
  if [ "$quiet" = 0 ]; then
    echo
    echo ">> SP Flash Tool is installed. Start it with:  spft"
  fi
}

# --- setting up Debian ---------------------------------------------------------------------------------

root_check() {
  unset LD_LIBRARY_PATH LD_PRELOAD
  local free sdk rel abis where krel need scr short z blockers='' limits=''
  # blocker  = spft cannot run on this device at all;  limit = it runs, but something will not work
  blocker() { blockers="$blockers - $1"$'\n'; }
  limit() { limits="$limits - $1"$'\n'; }
  case "$(kernel_arch)" in
    64) row kernel "64-bit ARM (CONFIG_ARM64=y) - OK, a 32-bit Android userspace doesn't matter" ;;
    32) row kernel "NOT a 64-bit ARM kernel - box64 needs one (use another host phone, or mtkclient)"
        blocker "the kernel is not 64-bit ARM, and box64 (the emulator) needs that" ;;
    *) row kernel "unknown (no /proc/config.gz) - 'spft install' will test it" ;;
  esac
  # the kernel VERSION: SP Flash Tool v5 asks for 4.19.14 or newer, and wrongly refuses 4.19.100 - 4.19.139 (lib/kernelfix.sh)
  # shellcheck source=lib/kernelfix.sh
  . "$LIB/kernelfix.sh"
  krel=$(uname -r 2>/dev/null || true)
  case "$(kernelfix_class "$krel")" in
    fine) row kernel-ver "$krel - OK for SP Flash Tool v5 (it asks for 4.19.14 or newer)" ;;
    text) row kernel-ver "$krel - SP Flash Tool v5 may refuse this kernel by mistake (it seems to compare versions as text). spft works around that by itself when it starts the tool" ;;
    old) row kernel-ver "$krel - older than the 4.19.14 that SP Flash Tool v5 asks for. The tool may refuse it, so try spft first. If it says \"Invalid linux kernel version\": SPFT_FAKE_KERNEL=5.4.0 spft (at your own risk)"
         limit "the kernel ($krel) is older than the 4.19.14 that SP Flash Tool v5 asks for, so the tool may stop with \"Invalid linux kernel version\" (try it first; if it does, SPFT_FAKE_KERNEL=5.4.0 spft shows it another version - your own risk; mtkclient has no such limit)" ;;
    *) row kernel-ver "${krel:-unknown} (could not read the version)" ;;
  esac
  if [ -d /sys/bus/usb/drivers/cdc_acm ]; then
    row cdc_acm "present - OK (the USB serial driver SP Flash Tool talks through)"
  else
    case "$(acm_config)" in
      m) row cdc_acm "NOT LOADED - this kernel has the driver as a module. Try:  su -c 'modprobe cdc_acm'  and run spft check again"
         limit "cdc_acm is not loaded: SP Flash Tool can't see a device from this phone until it is (su -c 'modprobe cdc_acm')" ;;
      n) row cdc_acm "MISSING - this kernel was built without it (CONFIG_USB_ACM), so SP Flash Tool can't see a device from this phone (use mtkclient instead)"
         limit "this kernel has no cdc_acm driver (CONFIG_USB_ACM), so SP Flash Tool can't talk to a device from this phone. spft still installs and starts here, which is enough to try it out; to flash, use a phone whose kernel has the driver (or mtkclient)" ;;
      y) row cdc_acm "not found, although the kernel config says it is built in. If the target is never detected, use another host phone (or mtkclient)" ;;
      *) row cdc_acm "not found, and the kernel config can't be read to tell why. If the target is never detected, use another host phone (or mtkclient)" ;;
    esac
  fi
  if find_chroot; then row chroot "$CHROOT"; else row chroot "NOT FOUND"; blocker "there is no chroot command (tried /system/bin, /system/xbin and Termux)"; fi
  sdk=$(getprop ro.build.version.sdk 2>/dev/null || true)
  rel=$(getprop ro.build.version.release 2>/dev/null || true)
  abis=$(getprop ro.product.cpu.abilist 2>/dev/null || true)
  row android "${rel:-unknown} (API ${sdk:-?}), ABIs: ${abis:-?}"
  free=$(free_mb /data)
  if [ -n "$free" ]; then
    row free "$free MB on /data (the install needs about 3000)"
    need=${SPFT_MIN_MB:-1500}
    if [ "$free" -lt "$need" ]; then
      blocker "only $free MB are free on /data, and the install needs about 3000 (it refuses below $need)"
    elif [ "$free" -lt 3000 ]; then
      limit "$free MB are free on /data: tight, the install needs about 3000"
    fi
  fi
  # the screen: the tool's window is about 720 pixels tall, and spft x11 picks the zoom that keeps it whole on screen
  scr=$(root_screen_size) || scr=
  if z=$(auto_zoom "$scr" 2>/dev/null); then
    short=${scr%%x*}
    if [ "${scr#*x}" -lt "$short" ]; then short=${scr#*x}; fi
    row screen "$scr pixels - spft x11 picks zoom $z%, a Termux:X11 screen $((short * 100 / z)) pixels tall (the tool's window needs about 720)"
  else
    row screen "could not read the size (wm size) - spft x11 then uses zoom 150. If the bottom of the tool window is cut off: spft x11 zoom=110"
  fi
  if [ -x "$R/bin/bash" ]; then row debian "installed in $R"; else row debian "not installed yet (spft install does that)"; fi
  if [ -x "$R/usr/local/bin/box64" ] || [ -x "$R/usr/bin/box64" ]; then row box64 "installed"; else row box64 "not installed yet (spft install does that)"; fi
  if where=$(root_tool_where); then row tool "${where#"$R"}"; else row tool "not installed yet (spft install gets it, or: spft tool)"; fi
  case $sdk in
    '' | *[!0-9]*) ;;
    *) if [ "$sdk" -ge 31 ]; then
      limit "Android 12 or newer: Android may kill background processes. If SP Flash Tool or Termux closes by itself, see the Guide on GitHub (docs/GUIDE.md), section \"Android 12 and newer\"."
    fi ;;
  esac
  echo
  echo "== Result =="
  if [ -n "$blockers" ]; then
    echo "spft can NOT run on this device, because:"
    printf '%s' "$blockers"
  else
    echo "spft can be installed and started on this device."
  fi
  if [ -n "$limits" ]; then
    echo "Keep in mind:"
    printf '%s' "$limits"
  fi
}

# The Termux:X11 app. spft does not mind where it came from (the nightly APK from GitHub, F-Droid, ...): it only needs it installed.
X11_APP_LINK=https://github.com/termux/termux-x11/releases/tag/nightly

cmd_check() {
  if is_root; then root_check; return 0; fi
  echo "== Termux =="
  local rc have_root=0
  if command -v su >/dev/null 2>&1; then
    echo "(your root app may ask now: press ALLOW for Termux)"
    if root_ok; then
      row root "su found, and root works"
      have_root=1
    else
      row root "su found, but root was REFUSED - open your root app and allow Termux (KernelSU, APatch: switch Termux on in the Superuser list), then run this again"
    fi
  else
    row root "NOT FOUND - this needs a rooted phone (Magisk, KernelSU, ...)"
  fi
  if command -v termux-x11 >/dev/null 2>&1; then row x11-pkg "installed"; else row x11-pkg "MISSING - run: pkg install x11-repo && pkg install termux-x11-nightly"; fi
  rc=0
  app_installed com.termux.x11 || rc=$?
  case $rc in
    0) row x11-app "Termux:X11 app installed" ;;
    1) row x11-app "NOT installed - get the Termux:X11 app, for example the nightly APK termux-x11-universal-debug.apk from $X11_APP_LINK" ;;
    *) row x11-app "could not tell if the Termux:X11 app is installed (Android hides other apps from Termux). If it is not, get it from $X11_APP_LINK" ;;
  esac
  if [ -d "$HOME/storage/downloads" ]; then row storage "Termux can read your Download folder"; else row storage "run termux-setup-storage once if you want Termux to see your Download folder (optional)"; fi
  echo "== phone and Debian =="
  if [ "$have_root" = 0 ]; then echo "(skipped: this part needs root)"; return 1; fi
  as_root check
}

write_provision() {
  need_lib
  cp -f "$LIB/provision.sh" "$R/root/spft-provision.sh"
  chmod 755 "$R/root/spft-provision.sh"
}

root_install() { # root_install TARBALL
  is_root || die "internal: needs root"
  local sig
  # the marker file proves a previous unpack ran to the end (an interrupted one is simply redone)
  if [ -e "$R/.spft-unpacked" ]; then
    echo ">> rootfs already unpacked in $R"
  else
    echo ">> unpacking rootfs into $R"
    mkdir -p "$R"
    env LD_LIBRARY_PATH="$PREFIX/lib" PATH="$PREFIX/bin:$PATH" "$PREFIX/bin/tar" -xpf "$1" -C "$R" --numeric-owner
    : > "$R/.spft-unpacked"
  fi
  find_chroot || die "no chroot command found (tried /system/bin, /system/xbin and Termux)"
  if ! err=$(chroot_run /bin/true 2>&1); then
    die "the arm64 Debian won't run on this phone: $err (run: spft check)"
  fi
  rm -f "$R/etc/resolv.conf"
  printf 'nameserver 1.1.1.1\nnameserver 8.8.8.8\n' > "$R/etc/resolv.conf"
  mkdir -p "$R/etc/apt/apt.conf.d" "$R/root" "$R/mnt/sdcard" "$R/opt"
  # Android: apt's unprivileged _apt user has no network access, so let apt download as root
  echo 'APT::Sandbox::User "root";' > "$R/etc/apt/apt.conf.d/01-android-nosandbox"
  write_provision
  # the provisioning only runs again when lib/provision.sh has changed since it last finished
  sig=$(cksum < "$LIB/provision.sh")
  if [ -f "$R/.spft-provisioned" ] && [ "$(cat "$R/.spft-provisioned")" = "$sig" ]; then
    echo ">> Debian is already set up (box64, libraries, desktop)"
  else
    root_enter /root/spft-provision.sh
    if [ -e "$R/root/.spft-selftest-failed" ]; then
      echo ">> the box64 self-test failed, so Debian is not marked as set up (the next 'spft install' tries again)"
      return 3
    fi
    printf '%s\n' "$sig" > "$R/.spft-provisioned"
  fi
}

cmd_install() { # cmd_install [--no-tool]
  ! is_root || die "run install from Termux as a normal user (it calls su itself)"
  local want_tool=1 a free
  for a in "$@"; do
    case $a in
      --no-tool) want_tool=0 ;;
      *) die "install: unknown option '$a'  (the only option is --no-tool)" ;;
    esac
  done
  need_lib
  need_su
  say "checking root"
  root_ok || die "root was refused. Open your root app (Magisk, KernelSU, ...), allow Termux, then run this again"
  case "$(kernel_arch)" in
    32) die "this phone's kernel is not a 64-bit ARM kernel, so the 64-bit emulator (box64) can't run here. Use a phone or tablet with a 64-bit kernel as the host, or stay with mtkclient." ;;
    64) echo ">> kernel is 64-bit ARM - OK (a 32-bit Android userspace and 32-bit Termux don't matter)" ;;
    *) echo ">> can't read /proc/config.gz - will test 64-bit support after unpacking" ;;
  esac
  free=$(free_mb "$PREFIX")
  if [ -n "$free" ]; then
    if [ "$free" -lt "${SPFT_MIN_MB:-1500}" ]; then
      die "only $free MB are free on the phone's storage, and the install needs about 3000. Free some space (delete apps, photos or old downloads) and run this again."
    elif [ "$free" -lt 3000 ]; then
      echo ">> $free MB are free - that is tight (about 3000 are needed). If the install stops with 'No space left on device', free some space and run it again."
    fi
  fi
  wake_lock
  pkg install -y wget curl xz-utils tar unzip coreutils || die "pkg could not install the Termux packages (try: termux-change-repo)"
  mkdir -p "$DL"
  if [ ! -s "$DL/rootfs.tar.gz" ]; then
    say "downloading Debian $SUITE arm64 (about 30 MB)"
    if ! wget -O "$DL/rootfs.part" "$URL"; then
      rm -f "$DL/rootfs.part"
      die "could not download Debian from $URL - check the internet connection, then run: spft install"
    fi
    mv "$DL/rootfs.part" "$DL/rootfs.tar.gz"
  fi
  [ "$(wc -c < "$DL/rootfs.tar.gz")" -gt 10000000 ] ||
    die "$DL/rootfs.tar.gz is too small to be a rootfs - delete it, or set SPFT_URL to a Debian arm64 rootfs tarball"
  say "setting up Debian: box64, libraries, desktop (15-30 minutes the first time)"
  echo "   Four steps follow. A moving bar shows that apt is checking, downloads show a counter (MB and files), the installing"
  echo "   shows a counter, and a line appears every 20 seconds while a step is busy."
  echo "   The longest is '[2/4] arm64 + x86_64 libraries'. It is working, not stuck, even when it takes minutes."
  local rc=0
  root_call root-install "$DL/rootfs.tar.gz" || rc=$?
  case $rc in
    0 | 3) ;;
    *) die "setting up Debian failed (exit $rc) - read the messages above, then run: spft install" ;;
  esac
  local tool_ok=1
  if [ "$want_tool" = 1 ]; then
    say "SP Flash Tool"
    # in a subshell: a `die` inside must not end the whole install, Debian is already set up at this point
    (cmd_tool --if-missing) || tool_ok=0
  fi
  if [ "$rc" = 3 ]; then
    say "Debian is set up, but the box64 self-test FAILED (see above): SP Flash Tool will not start until it passes."
    echo "   Run 'spft install' to try again, and 'spft check' to look at the phone."
    return 1
  fi
  if [ "$tool_ok" = 0 ]; then
    say "Debian is ready, but SP Flash Tool is NOT installed yet."
    echo "   Follow the steps above to get the zip, then run:  spft tool"
    echo "   After that, start it with:  spft"
    return 1
  fi
  say "done. Start SP Flash Tool with:  spft"
}

cmd_update() {
  ! is_root || die "run update from Termux as a normal user"
  command -v git >/dev/null 2>&1 || die "git is missing - run: pkg install git"
  [ -d "$SPFT_HOME/.git" ] || die "this copy of spft was not made with git clone, so it can't update itself - clone the repository again (see the README)"
  say "getting the newest spft"
  git -C "$SPFT_HOME" pull --ff-only
  say "applying it"
  exec "$PREFIX/bin/bash" "$SELF" install
}

# --- Termux:X11 display: landscape, fullscreen, bigger ------------------------------------------------
# `termux-x11-preference` changes the Termux:X11 app's own settings while it runs. Its exit status can say "ok"
# for a value the app refused, and one refused key throws away the whole batch. So: one key per call, then
# read every setting back with `list` and check.
X11_KEYS="fullscreen forceOrientation displayScale displayResolutionMode displayFilteringMode additionalKbdVisible"
X11_CUR=
X11_BAD=

x11_list() { timeout 6 termux-x11-preference list 2>/dev/null || true; }
x11_get() { printf '%s\n' "$X11_CUR" | sed -n "s/^\"$1\"=\"\\(.*\\)\"\$/\\1/p" | head -n 1; }

x11_open() { # bring the Termux:X11 app to the front (it starts if it was closed)
  am start --user 0 -n com.termux.x11/com.termux.x11.MainActivity >/dev/null 2>&1 ||
    echo ">> could not open the Termux:X11 app by itself - open it from the launcher"
}

x11_wait() { # wait for the app to answer (it takes a moment after opening); its settings end up in X11_CUR
  for _ in 1 2 3 4 5 6 7 8; do
    X11_CUR=$(x11_list)
    case $X11_CUR in *'"fullscreen"="'*) return 0 ;; esac
    sleep 1
  done
  return 1
}

x11_save() { # remember the settings as they were, once, so that `x11 reset` can put them back
  local f=$DL/x11-prefs.orig k v
  [ ! -f "$f" ] || return 0
  mkdir -p "$DL"
  for k in $X11_KEYS; do
    v=$(x11_get "$k")
    if [ -n "$v" ]; then printf '%s:%s\n' "$k" "$v"; fi
  done > "$f"
}

x11_apply() { # x11_apply key:value ...   set what differs; returns 1 when something could not be set
  local a k v cur changed=0 bad=
  for a in "$@"; do
    k=${a%%:*}; v=${a#*:}
    cur=$(x11_get "$k")
    [ -n "$cur" ] || continue              # this Termux:X11 version does not have that setting
    [ "$cur" != "$v" ] || continue
    x11_save
    echo "   $k: $cur -> $v"
    timeout 15 termux-x11-preference "$a" >/dev/null 2>&1 || true
    changed=1
  done
  if [ "$changed" -eq 1 ]; then sleep 1; X11_CUR=$(x11_list); fi    # read it all back
  for a in "$@"; do
    k=${a%%:*}; v=${a#*:}
    if [ -z "$(x11_get "$k")" ]; then bad="$bad $k(not in this app version)"
    elif [ "$(x11_get "$k")" != "$v" ]; then bad="$bad $k"
    fi
  done
  X11_BAD=$bad
  if [ -z "$bad" ]; then return 0; fi
  echo "   not applied:$bad" >&2
  return 1
}

x11_manual() { # x11_manual ORIENTATION ZOOM: the same thing by hand
  cat >&2 <<EOF
   By hand instead: in the Termux:X11 app open Preferences > Output and set
     Screen orientation = $1    Fullscreen = on    Display resolution mode = scaled    Display scale, % = $2
EOF
}

x11_layout() { # x11_layout ORIENTATION ZOOM KEYS: rotate, fill the screen, enlarge, hide the extra-keys bar
  local orient=$1 zoom=$2 keys=$3 filt=bilinear
  if [ $((zoom % 100)) -eq 0 ]; then filt=nearest; fi    # a whole-number zoom stays sharp without smoothing
  if ! command -v termux-x11-preference >/dev/null 2>&1; then
    echo ">> termux-x11-preference is missing (try: pkg upgrade termux-x11-nightly), so the display can't be set up for you" >&2
    x11_manual "$orient" "$zoom"
    return 0
  fi
  echo ">> setting up the Termux:X11 display: $orient, fullscreen, zoom $zoom%"
  if ! x11_wait; then
    echo ">> the Termux:X11 app did not answer, so its settings were not changed" >&2
    x11_manual "$orient" "$zoom"
    return 0
  fi
  # additionalKbdVisible goes first: the app does not redraw when that one changes, but it does for each key after it
  if ! x11_apply "additionalKbdVisible:$keys" "fullscreen:true" "forceOrientation:$orient" "displayScale:$zoom" \
    "displayResolutionMode:scaled" "displayFilteringMode:$filt"; then
    # the by-hand steps are only worth showing when one of the four that matter did not take
    case $X11_BAD in *fullscreen* | *forceOrientation* | *displayScale* | *displayResolutionMode*) x11_manual "$orient" "$zoom" ;; esac
  fi
}

x11_reset() { # put the settings back as x11_save found them
  local f=$DL/x11-prefs.orig a args=()
  if [ ! -f "$f" ]; then
    echo ">> nothing to put back: spft has not changed the Termux:X11 settings"
    return 0
  fi
  command -v termux-x11-preference >/dev/null 2>&1 || die "termux-x11-preference is missing (try: pkg upgrade termux-x11-nightly)"
  x11_wait || die "the Termux:X11 app did not answer - open it, then run this again"
  while IFS= read -r a || [ -n "$a" ]; do
    if [ -n "$a" ]; then args+=("$a"); fi
  done < "$f"
  echo ">> putting the Termux:X11 settings back as they were"
  if [ "${#args[@]}" -eq 0 ] || x11_apply "${args[@]}"; then
    rm -f "$f"
    echo ">> done"
  else
    echo ">> kept $f because something could not be put back" >&2
  fi
}

# --- the zoom: as big as the tool's window still fits ----------------------------------------------------------
# The tool's main window is about 720 pixels tall, and it cannot be made shorter: on a Termux:X11 screen that is shorter
# its bottom row is cut off. In landscape that screen is as tall as the SHORT side of the phone divided by the zoom, so the
# biggest zoom that still fits is  short side * 100 / 720.  X11_MIN_HEIGHT keeps a little room (the window frame takes
# some). 1280x800 tablet: zoom 105, a screen of 761 pixels. Phone 1080 wide: zoom 145, 744 pixels.
X11_MIN_HEIGHT=740

# auto_zoom WIDTHxHEIGHT   the biggest zoom, in steps of 5 and between 30 and 300, that keeps the screen X11_MIN_HEIGHT tall
auto_zoom() {
  local w=${1%%x*} h=${1#*x} short z
  case $w$h in '' | *[!0-9]*) return 1 ;; esac
  short=$w
  if [ "$h" -lt "$w" ]; then short=$h; fi
  z=$((short * 100 / X11_MIN_HEIGHT / 5 * 5))
  if [ "$z" -lt 30 ]; then z=30; fi
  if [ "$z" -gt 300 ]; then z=300; fi
  echo "$z"
}

# root_screen_size   the phone's screen in pixels, like 1280x800: what `wm size` says is the size now (Override size if it
# was changed, Physical size otherwise). Exit status 1 when it can't be told.
root_screen_size() {
  unset LD_LIBRARY_PATH LD_PRELOAD
  local out s
  out=$(/system/bin/wm size 2>/dev/null) || return 1
  s=$(printf '%s\n' "$out" | sed -n 's/^Override size: *\([0-9][0-9]*x[0-9][0-9]*\).*/\1/p' | head -n 1)
  [ -n "$s" ] || s=$(printf '%s\n' "$out" | sed -n 's/^Physical size: *\([0-9][0-9]*x[0-9][0-9]*\).*/\1/p' | head -n 1)
  [ -n "$s" ] || return 1
  printf '%s\n' "$s"
}

# pick_zoom   prints the zoom for this screen (what to do when the user gave none). Its messages go to stderr.
pick_zoom() {
  local size z
  size=$(root_call root-screen-size 2>/dev/null | tail -n 1) || size=
  if z=$(auto_zoom "$size" 2>/dev/null); then
    echo ">> screen $size: zoom $z% keeps the whole tool window on it (choose your own with: spft x11 zoom=N)" >&2
    echo "$z"
  else
    echo ">> could not read the screen size, so zoom 150 is used. If the bottom of the tool window is cut off, run: spft x11 zoom=110" >&2
    echo 150
  fi
}

cmd_x11() { # cmd_x11 [options]: Termux:X11 server and app as the normal Termux user, then the tool inside Debian
  ! is_root || die "run spft from Termux as a normal user (it calls su itself)"
  local orient=landscape zoom='' zgiven=0 keys=false action=layout a
  for a in "$@"; do
    case $a in
      landscape) orient=landscape ;;
      reverse) orient="reverse landscape" ;;
      portrait|auto) orient=$a ;;
      zoom=*) zoom=${a#zoom=}; zgiven=1 ;;
      keys) keys=true ;;
      plain|reset) action=$a ;;
      *) die "x11: unknown option '$a'  (options: reverse portrait auto zoom=N keys plain reset)" ;;
    esac
  done
  if [ "$zgiven" = 0 ]; then zoom=auto; fi
  # the tool is wider than a portrait screen, so it only gets zoomed in landscape
  case $orient in portrait | auto) if [ "$zoom" = auto ]; then zoom=100; fi ;; esac
  if [ "$zoom" != auto ]; then
    case $zoom in '' | *[!0-9]*) die "x11: zoom=N needs a whole number (or the word auto), for example zoom=150" ;; esac
    [ "${#zoom}" -le 3 ] || die "x11: zoom must be between 30 and 300"
    zoom=$((10#$zoom))
    if [ "$zoom" -lt 30 ] || [ "$zoom" -gt 300 ]; then die "x11: zoom must be between 30 and 300"; fi
  fi
  need_su
  command -v termux-x11 >/dev/null 2>&1 ||
    die "termux-x11 is not installed. In Termux run:  pkg install x11-repo  and then  pkg install termux-x11-nightly
     (and, if you do not have it yet, the Termux:X11 app: the file termux-x11-universal-debug.apk from
      https://github.com/termux/termux-x11/releases/tag/nightly - or run: bash install.sh)"
  if [ "$action" = reset ]; then
    x11_open
    x11_reset
    return 0
  fi
  # Note: no test of the Debian folder here. The normal Termux user may not look inside it; the root step checks.
  local sock=$PREFIX/tmp/.X11-unix/X0 n=0
  if [ ! -S "$sock" ]; then
    echo ">> starting the Termux:X11 server"
    mkdir -p "$DL"
    nohup termux-x11 :0 >"$DL/x11.log" 2>&1 &
    while [ ! -S "$sock" ] && [ "$n" -lt 20 ]; do sleep 1; n=$((n + 1)); done
    if [ ! -S "$sock" ]; then
      tail -n 10 "$DL/x11.log" >&2
      die "the Termux:X11 server did not start (is the Termux:X11 app installed? see the messages above)"
    fi
  fi
  x11_open
  if [ "$action" = layout ]; then
    if [ "$zoom" = auto ]; then zoom=$(pick_zoom); fi
    x11_layout "$orient" "$zoom" "$keys"
  fi
  wake_lock    # keeps the CPU awake while the tool runs: a phone that falls asleep in the middle of a flash can ruin it
  debian_settings
  as_root enter SPFT_DISPLAY=x11 ${DSET[@]+"${DSET[@]}"} spft-run
}

cmd_vnc() {
  ! is_root || die "run spft from Termux as a normal user (it calls su itself)"
  need_su
  wake_lock
  debian_settings
  as_root enter SPFT_DISPLAY=vnc ${DSET[@]+"${DSET[@]}"} spft-run
}

# --- stop: everything of spft, and the caches ------------------------------------------------------------------
# `spft stop` ends every part of spft, then clears what they leave behind. Two phases, like the other commands: the normal
# Termux user (cmd_stop) calls the root step (root_stop), which can see and end every process, and then clears up whatever
# is left on the Termux side.
#   ended:    every program that runs inside Debian (SP Flash Tool, box64, openbox, the VNC server, shells),
#             the Termux:X11 server, the Termux:X11 app (force-stopped)
#   unmounted: what `enter` mounted into Debian
#   cleared:  Debian's /tmp (sockets, logs, the kernel-fix library) and ~/.cache, the Termux:X11 app's cache folders,
#             and the kernel's memory cache for files
#   NOT touched: the tool and its own settings and logs, your files, Debian's packages, apt's downloads (an interrupted
#             install carries on from them), the Termux:X11 settings (`spft x11 reset` puts those back)

X11_PKG=com.termux.x11                              # the Termux:X11 app
X11_DATA=/data/data/$X11_PKG                        # its private data (the caches in it)
X11_MEDIA=/data/media/0/Android/data/$X11_PKG       # its cache folder on the shared storage
X11_KILLED=0                                        # how many server processes x11_server_kill found

# The Termux:X11 server renames its process "termux-x11 <app id> :0" (its README: "pkill -f termux-x11"). Prints the PID
# of every one of them that can be seen (the normal Termux user sees its own, root sees all).
x11_server_pids() {
  local p c
  for p in /proc/[0-9]*; do
    c=$({ tr '\0' ' ' < "$p/cmdline"; } 2>/dev/null) || continue
    case $c in *"termux-x11 "*) echo "${p#/proc/}" ;; esac
  done
  return 0
}

# Ends the Termux:X11 server: TERM first, then KILL for one that does not go. X11_KILLED is how many there were.
x11_server_kill() {
  local pids
  pids=$(x11_server_pids)
  X11_KILLED=$(printf '%s\n' "$pids" | grep -c .) || true
  [ -n "$pids" ] || return 0
  # shellcheck disable=SC2086
  kill $pids 2>/dev/null || true
  sleep 1
  pids=$(x11_server_pids)
  if [ -n "$pids" ]; then
    # shellcheck disable=SC2086
    kill -9 $pids 2>/dev/null || true
    sleep 1
  fi
  return 0
}

# Removes what a Termux:X11 server leaves behind in Termux's tmp folder: the socket file and the lock file. A server that was
# killed (by Android, say) leaves them, and with the socket in the way spft thinks a server is running and the screen stays
# black. Call it only when no server runs. Prints what it removed.
x11_server_clean() {
  local f n=0
  for f in "$PREFIX/tmp/.X11-unix/X0" "$PREFIX/tmp/.X0-lock"; do
    if [ -e "$f" ] || [ -L "$f" ]; then rm -f "$f" && n=$((n + 1)); fi
  done
  X11_CLEANED=$n
  return 0
}
X11_CLEANED=0

# Unmounts what `enter` mounted into Debian, quietly. Exit status 1 when something is still mounted afterwards.
unmount_all() {
  local d round
  for round in 1 2; do    # the second round is for a mount that was still busy during the first
    # shellcheck disable=SC2086
    for d in $MOUNT_DIRS; do
      if is_mounted "$R/$d"; then /system/bin/umount "$R/$d" >/dev/null 2>&1 || true; fi
    done
    if ! grep -qF " $R" /proc/mounts; then return 0; fi
    if [ "$round" = 1 ]; then sleep 1; fi
  done
  return 1
}

# size_kb DIR...   how many KB the folders hold together (a folder that is not there counts 0)
size_kb() {
  local d total=0 k
  for d in "$@"; do
    [ -d "$d" ] || continue
    k=$(/system/bin/du -sk "$d" 2>/dev/null | { read -r k _ || true; echo "${k:-0}"; })
    case $k in '' | *[!0-9]*) k=0 ;; esac
    total=$((total + k))
  done
  echo "$total"
}

# clear_dir DIR   empty a folder and keep the folder. It refuses a path that is not at least three levels deep (never / or
# /data), and it never goes into a mount point: a recursive delete through one would delete the phone's own files.
clear_dir() {
  local d=$1 e
  case $d in /*/*/*) ;; *) return 1 ;; esac
  [ -d "$d" ] || return 0
  for e in "$d"/* "$d"/.[!.]* "$d"/..?*; do
    if [ ! -e "$e" ] && [ ! -L "$e" ]; then continue; fi    # a pattern that matched nothing
    if is_mounted "$e"; then continue; fi
    /system/bin/rm -rf "$e" 2>/dev/null || true
  done
  return 0
}

# Empties the cache folders (see above) and prints one row about it.
clean_caches() {
  local dirs="$X11_DATA/cache $X11_DATA/code_cache $X11_MEDIA/cache" before after kb tenth d
  local what="Debian's /tmp and ~/.cache, the Termux:X11 app's cache"
  if grep -qF " $R" /proc/mounts; then
    # a recursive delete must not get anywhere near a mount: Debian's own folders wait until nothing is mounted in it
    what="the Termux:X11 app's cache only. Debian's own folders were left alone: something is still mounted in it"
  else
    dirs="$R/tmp $R/root/.cache $dirs"
  fi
  # shellcheck disable=SC2086
  before=$(size_kb $dirs)
  # shellcheck disable=SC2086
  for d in $dirs; do clear_dir "$d" || true; done
  # shellcheck disable=SC2086
  after=$(size_kb $dirs)
  kb=$((before - after))
  if [ "$kb" -lt 0 ]; then kb=0; fi
  tenth=$((kb * 10 / 1024))
  row cache "cleared, $((tenth / 10)).$((tenth % 10)) MB freed ($what)"
}

# The kernel keeps the files it read lately in memory; this gives that memory back (it is what "clear the cache" means for RAM).
drop_memory_cache() {
  /system/bin/sync >/dev/null 2>&1 || true
  { echo 3 > /proc/sys/vm/drop_caches; } 2>/dev/null
}

# The root step of `spft stop`.
root_stop() {
  unset LD_LIBRARY_PATH LD_PRELOAD
  echo "== stopping everything of spft =="
  kill_chroot > /dev/null
  if [ "$KILLED" -gt 0 ]; then
    row debian "stopped $KILLED process(es): SP Flash Tool, box64, openbox and everything else that ran inside Debian"
  else
    row debian "nothing was running inside Debian"
  fi
  x11_server_kill
  x11_server_clean
  if [ "$X11_KILLED" -gt 0 ]; then
    row x11-server "stopped the Termux:X11 server"
  elif [ "$X11_CLEANED" -gt 0 ]; then
    row x11-server "no server was running; removed the file that an old one left behind"
  else
    row x11-server "no server was running"
  fi
  if /system/bin/am force-stop "$X11_PKG" > /dev/null 2>&1; then
    row x11-app "the Termux:X11 app is force-stopped"
  else
    row x11-app "could not force-stop the Termux:X11 app - close it by hand if it is still open"
  fi
  if unmount_all; then
    row mounts "all unmounted (Debian is no longer linked to the phone's /dev, /proc, /sys and storage)"
  else
    row mounts "WARNING: still mounted (busy?) - $(grep -F " $R" /proc/mounts | cut -d' ' -f2 | tr '\n' ' ')"
  fi
  clean_caches
  if drop_memory_cache; then
    row memory "the phone's file cache was dropped, so more RAM is free"
  else
    row memory "the kernel does not allow dropping its file cache here (harmless)"
  fi
}

# For the normal Termux user: the root step, then what is left on the Termux side. (After a server that was killed by
# Android there is only a leftover socket file; after root_stop there is nothing left to do, and it stays silent.)
x11_server_stop() {
  x11_server_kill
  x11_server_clean
  if [ "$X11_KILLED" -gt 0 ]; then echo "stopped the Termux:X11 server"; fi
  if [ "$X11_CLEANED" -gt 0 ] && [ "$X11_KILLED" -eq 0 ]; then echo "removed an old Termux:X11 socket (no server was running)"; fi
  return 0
}

cmd_stop() {
  local rc=0
  if is_root; then root_stop; return 0; fi
  need_su
  root_call stop || rc=$?
  x11_server_stop
  wake_unlock
  if [ "$rc" -ne 0 ]; then
    echo "spft: the root step of stop did not finish (exit status $rc), so something may still be running." >&2
    echo "      Run  spft stop  again, or restart the phone." >&2
    return 1
  fi
  if command -v termux-wake-unlock >/dev/null 2>&1; then row wakelock "released, the phone may sleep again"; fi
  echo
  echo "All of spft is stopped. Start it again with:  spft"
}

cmd_uninstall() { # cmd_uninstall [--yes]
  ! is_root || die "run uninstall from Termux as a normal user (it calls su itself)"
  local yes=0 a answer=''
  for a in "$@"; do
    case $a in
      --yes | -y) yes=1 ;;
      *) die "uninstall: unknown option '$a'  (the only option is --yes)" ;;
    esac
  done
  need_su
  echo "This deletes the Debian system in $R (SP Flash Tool, box64 and everything else inside it)"
  echo "and the downloads in $DL. It stops SP Flash Tool if it is running."
  echo "Your own files in the phone's storage are NOT touched. The spft command and its folder stay."
  if [ "$yes" = 0 ]; then
    printf 'Type yes and press Enter to continue: '
    read -r answer || answer=
    if [ "$answer" != yes ]; then echo "cancelled - nothing was deleted"; return 1; fi
  fi
  root_call root-uninstall || die "the Debian folder was NOT deleted (see above)"
  # the downloads: only the files spft itself makes, never the whole folder (SPFT_DL could point anywhere)
  if [ -f "$DL/app/spft" ]; then rm -rf "$DL/app"; fi
  rm -f "$DL/rootfs.tar.gz" "$DL/rootfs.part" "$DL/x11.log" "$DL/x11-prefs.orig" "$DL"/SP_Flash_Tool_*.zip "$DL"/*.part
  rmdir "$DL" 2>/dev/null || true
  wake_unlock
  say "removed. To remove spft itself as well, run:  rm -rf \"$SPFT_HOME\" \"$PREFIX/bin/spft\""
}

case "${1:-}" in
  "") cmd_x11 ;;
  start | x11) shift; cmd_x11 "$@" ;;
  vnc) cmd_vnc ;;
  stop) cmd_stop ;;
  tool) shift; cmd_tool "$@" ;;
  check) cmd_check ;;
  install) shift; cmd_install "$@" ;;
  update) cmd_update ;;
  enter) shift; is_root || as_root enter "$@"; root_enter "$@" ;;
  umount) is_root || as_root umount; root_umount ;;
  uninstall) shift; cmd_uninstall "$@" ;;
  help | -h | --help) usage ;;
  app-installed) rc=0; app_installed "${2:?package name missing}" || rc=$?; exit "$rc" ;;
  root-check) root_check ;;
  root-app-installed) rc=0; root_app_installed "${2:?package name missing}" || rc=$?; case $rc in 0) echo yes ;; 1) echo no ;; *) echo unknown ;; esac ;;
  root-uninstall) root_uninstall ;;
  root-install) root_install "${2:?tarball path missing}" ;;
  root-tool) root_tool "${2:?zip path missing}" ;;
  root-tool-where) root_tool_where ;;
  root-find-zip) root_find_zip "${2:?name missing}" ;;
  root-screen-size) root_screen_size ;;
  *) usage >&2; exit 1 ;;
esac
